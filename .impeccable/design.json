	"narrative": {
		"northStar": "The Plain Record",
		"overview": "The portfolio is a working record, read in under a minute by someone filling a fullstack role. It is type-led, evidence-forward, and deliberately unremarkable in its genre: a name, a claim, two projects, the numbers, the failures, and a way to make contact. The craft is in the hierarchy and the facts, not in a governing metaphor. The page behaves like a well-set document that happens to be a website. A real product screenshot is evidence, not decoration. A metric sits next to its run ID and its date. A failure is written at the same weight as a win. The single accent marks the active and the linked; everything else is ink, paper, and a hairline.",
		"keyCharacteristics": [
			"A strong grotesque hierarchy, with mono reserved for evidence.",
			"Two themes, one signal. Light is the default; dark mirrors every role.",
			"Flat surfaces, 1px rules, 2px corners. No shadows, no glass, no gradients.",
			"Real product screenshots, cropped to remove identifiers.",
			"Copy that carries a number, a date, or a named failure."
		],
		"rules": [
			{
				"name": "The One Signal Rule",
				"body": "Signal Blue marks the active, the linked, and the measured. It never fills a decorative block, and it never becomes a second brand colour. Data states are the only other hue, and they always pair with a word.",
				"section": "colors"
			},
			{
				"name": "The Named State Rule",
				"body": "A badge is never colour-only. “Correct”, “Wrong”, “No diagnosis”, “High”, “Medium”, and “Low” are part of the component, not an accessible-name afterthought.",
				"section": "colors"
			},
			{
				"name": "The Evidence Is Monospaced Rule",
				"body": "A number, date, run ID, commit count, file name, or verdict label is set in Azeret Mono. Prose is set in Archivo. Mixing the two is a hierarchy decision, not a decoration.",
				"section": "typography"
			},
			{
				"name": "The Greek Is Data Rule",
				"body": "Every Greek disease name carries lang=\"el\" and the Noto Sans face. It is not a stylistic accent, and it never falls back silently.",
				"section": "typography"
			},
			{
				"name": "The Flat-By-Default Rule",
				"body": "A surface is flat at rest. If a state needs emphasis, change the rule, the ink, or the background; do not add a shadow.",
				"section": "elevation"
			}
		],
		"dos": [
			"Do keep one accent and make it earn its place: links, active states, measured marks.",
			"Do set every number, date, run ID, and verdict label in Azeret Mono.",
			"Do label the ten-case test as a product test, not a validation study, wherever the numbers appear.",
			"Do check both themes at 390, 768, and 1440px with axe-core.",
			"Do use real product screenshots and crop them to remove identifiers.",
			"Do keep prose lines between 65 and 75 characters."
		],
		"donts": [
			"Don't add a shadow, blur, glass panel, or decorative gradient.",
			"Don't put a tracked uppercase eyebrow chip above an oversized hero headline; the name is in the header and the claim is the headline.",
			"Don't number sections as decorative scaffolding. Case-study section numbers are navigation; home sections are not.",
			"Don't use colour as the only signal for a verdict or a state.",
			"Don't publish assets/, docs/, README.md, DEPLOY.md, or ASSETS.md.",
			"Don't reproduce a KPMG or client brand, screenshot, credential, or metric.",
			"Don't invent a metric, a testimonial, a logo, or a claim above what is built."
		]
	}
